prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: @GRAPHALG_PKG_NAME@
Description: @GRAPHALG_PKG_SUMMARY@
URL: @GRAPHALG_PROJECT_HOME@
Version: @GRAPHALG_PKG_VERSION@
Requires: graphdata
Libs: -L${libdir} -lgraphAlg
Cflags: -I${includedir}
