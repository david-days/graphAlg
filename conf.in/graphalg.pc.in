prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: @GRAPHALG_PKG_NAME@
Description: @GRAPHALG_PKG_SUMMARY@
URL: @GRAPHALG_PROJECT_HOME@
Version: @GRAPHALG_PKG_VERSION@
Requires: graphdata
Libs: -L${libdir} -lgraphAlg
Cflags: -I${includedir}
